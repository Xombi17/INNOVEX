{
  "manifest_version": 3,
  "name": "ScopeBomb \u2014 Pre-Consent OAuth Guard",
  "version": "1.1.0",
  "description": "Intercepts over-scoped Google, GitHub, and Microsoft Entra OAuth requests before consent without corrupting PKCE code_challenge.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "https://accounts.google.com/o/oauth2/v2/auth*",
    "https://github.com/login/oauth/authorize*",
    "https://login.microsoftonline.com/*/oauth2/v2.0/authorize*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://accounts.google.com/o/oauth2/v2/auth*",
        "https://github.com/login/oauth/authorize*",
        "https://login.microsoftonline.com/*/oauth2/v2.0/authorize*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScopeBomb Pre-Consent Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
