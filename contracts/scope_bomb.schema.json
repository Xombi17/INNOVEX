{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopebomb.dev/contracts/scope_bomb.schema.json",
  "title": "ScopeBomb Frozen Contract v1.0.0",
  "description": "Authoritative contract shared across Codex core engine (packages/engine), Next.js web arena (apps/web), and Chrome MV3 guard (apps/extension). Workers MUST treat this file as read-only.",
  "type": "object",
  "required": [
    "schema_version",
    "input_mode",
    "summary",
    "parsed_oauth",
    "shadow_secrets",
    "graph",
    "naive_containment",
    "full_containment",
    "pre_consent_guard",
    "ai_explainer_used"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "input_mode": { "$ref": "#/$defs/InputMode" },
    "preset_id": { "type": ["string", "null"] },
    "summary": { "$ref": "#/$defs/ReportSummary" },
    "parsed_oauth": { "anyOf": [{ "$ref": "#/$defs/ParsedOAuthParams" }, { "type": "null" }] },
    "shadow_secrets": {
      "type": "array",
      "items": { "$ref": "#/$defs/ShadowSecretFinding" }
    },
    "graph": { "$ref": "#/$defs/BlastRadiusGraph" },
    "naive_containment": { "$ref": "#/$defs/ContainmentOutcome" },
    "full_containment": { "$ref": "#/$defs/ContainmentOutcome" },
    "pre_consent_guard": { "$ref": "#/$defs/PreConsentDecision" },
    "ai_explainer_used": { "type": "boolean" }
  },
  "$defs": {
    "ProviderId": {
      "type": "string",
      "enum": [
        "google",
        "github",
        "microsoft",
        "slack",
        "salesforce",
        "vercel",
        "anthropic",
        "openai",
        "generic"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "TrustBoundary": {
      "type": "string",
      "enum": [
        "personal",
        "developer_local",
        "vendor",
        "ci_cd",
        "enterprise_tenant"
      ]
    },
    "InputMode": {
      "type": "string",
      "enum": ["oauth_url", "mcp_config", "takeout_grant", "incident_preset"]
    },
    "AuditInput": {
      "type": "object",
      "required": ["mode", "raw_payload", "simulation_mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/InputMode" },
        "raw_payload": { "type": "string" },
        "preset_id": { "type": ["string", "null"] },
        "simulation_mode": {
          "type": "string",
          "enum": ["naive_single_revoke", "full_multi_issuer"]
        }
      }
    },
    "LeastPrivilegeAlternative": {
      "type": "object",
      "required": ["scope_id", "description", "notes"],
      "additionalProperties": false,
      "properties": {
        "scope_id": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "ScopeCatalogEntry": {
      "type": "object",
      "required": [
        "provider",
        "scope_id",
        "display_name",
        "severity",
        "category",
        "capabilities",
        "enables_targets",
        "persistence_vectors",
        "least_privilege_alternative",
        "is_pkce_sensitive",
        "revocation_endpoint",
        "rfc7009_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": { "$ref": "#/$defs/ProviderId" },
        "scope_id": { "type": "string" },
        "display_name": { "type": "string" },
        "severity": { "$ref": "#/$defs/Severity" },
        "category": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "enables_targets": { "type": "array", "items": { "type": "string" } },
        "persistence_vectors": { "type": "array", "items": { "type": "string" } },
        "least_privilege_alternative": { "$ref": "#/$defs/LeastPrivilegeAlternative" },
        "is_pkce_sensitive": { "type": "boolean" },
        "revocation_endpoint": { "type": ["string", "null"] },
        "rfc7009_notes": { "type": "string" }
      }
    },
    "ReportSummary": {
      "type": "object",
      "required": [
        "headline",
        "max_risk_score",
        "max_hops",
        "trust_boundary_crossings",
        "exposed_asset_count",
        "incident_framing_note"
      ],
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string" },
        "max_risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_hops": { "type": "integer", "minimum": 0 },
        "trust_boundary_crossings": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrustBoundary" }
        },
        "exposed_asset_count": { "type": "integer", "minimum": 0 },
        "incident_framing_note": { "type": "string" }
      }
    },
    "ParsedOAuthParams": {
      "type": "object",
      "required": [
        "provider",
        "client_id",
        "redirect_uri",
        "requested_scopes",
        "response_type",
        "access_type",
        "has_pkce",
        "code_challenge_method",
        "state_present"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": { "$ref": "#/$defs/ProviderId" },
        "client_id": { "type": ["string", "null"] },
        "redirect_uri": { "type": ["string", "null"] },
        "requested_scopes": { "type": "array", "items": { "type": "string" } },
        "response_type": { "type": ["string", "null"] },
        "access_type": { "type": ["string", "null"] },
        "has_pkce": { "type": "boolean" },
        "code_challenge_method": { "type": ["string", "null"] },
        "state_present": { "type": "boolean" }
      }
    },
    "ShadowSecretFinding": {
      "type": "object",
      "required": [
        "source_file",
        "provider",
        "key_name",
        "masked_preview",
        "grant_type",
        "rotation_issuer",
        "severity",
        "blast_targets"
      ],
      "additionalProperties": false,
      "properties": {
        "source_file": { "type": "string" },
        "provider": { "$ref": "#/$defs/ProviderId" },
        "key_name": { "type": "string" },
        "masked_preview": { "type": "string" },
        "grant_type": {
          "type": "string",
          "enum": ["oauth_token", "static_pat", "api_key", "service_account", "webhook_secret"]
        },
        "rotation_issuer": { "type": "string" },
        "severity": { "$ref": "#/$defs/Severity" },
        "blast_targets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "BlastNodeKind": {
      "type": "string",
      "enum": [
        "human_identity",
        "oauth_app",
        "shadow_ai_tool",
        "mcp_server",
        "scope",
        "data_store",
        "secret_credential",
        "attacker_persistence",
        "downstream_platform"
      ]
    },
    "BlastNode": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "provider",
        "severity",
        "risk_score",
        "trust_boundary",
        "survives_naive_revoke",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "kind": { "$ref": "#/$defs/BlastNodeKind" },
        "provider": { "$ref": "#/$defs/ProviderId" },
        "severity": { "$ref": "#/$defs/Severity" },
        "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "trust_boundary": { "$ref": "#/$defs/TrustBoundary" },
        "survives_naive_revoke": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "BlastEdgeRelation": {
      "type": "string",
      "enum": [
        "authorizes",
        "grants_scope",
        "exposes_secret",
        "crosses_boundary",
        "persists_after_revoke",
        "downgrades_to"
      ]
    },
    "BlastEdge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "mechanism",
        "hop",
        "survives_naive_revoke"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "relation": { "$ref": "#/$defs/BlastEdgeRelation" },
        "mechanism": { "type": "string" },
        "hop": { "type": "integer", "minimum": 1 },
        "survives_naive_revoke": { "type": "boolean" }
      }
    },
    "BlastRadiusGraph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/BlastNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/BlastEdge" } }
      }
    },
    "ContainmentActionType": {
      "type": "string",
      "enum": [
        "rfc7009_revoke",
        "github_grant_delete",
        "rotate_downstream_key",
        "audit_minted_apps",
        "inspect_ci_workflows",
        "invalidate_sessions"
      ]
    },
    "ContainmentStep": {
      "type": "object",
      "required": [
        "priority",
        "issuer",
        "target_resource",
        "action_type",
        "command_or_endpoint",
        "why_naive_fails",
        "verification_probe",
        "console_url"
      ],
      "additionalProperties": false,
      "properties": {
        "priority": { "type": "integer", "minimum": 1 },
        "issuer": { "type": "string" },
        "target_resource": { "type": "string" },
        "action_type": { "$ref": "#/$defs/ContainmentActionType" },
        "command_or_endpoint": { "type": "string" },
        "why_naive_fails": { "type": "string" },
        "verification_probe": { "type": "string" },
        "console_url": { "type": ["string", "null"] }
      }
    },
    "ContainmentOutcome": {
      "type": "object",
      "required": [
        "simulation_mode",
        "rfc7009_http_status_returned",
        "rfc7009_trap_warning",
        "jwt_residual_ttl_seconds",
        "contained_node_ids",
        "persisting_node_ids",
        "persisting_edge_ids",
        "containment_ratio",
        "ordered_steps"
      ],
      "additionalProperties": false,
      "properties": {
        "simulation_mode": {
          "type": "string",
          "enum": ["naive_single_revoke", "full_multi_issuer"]
        },
        "rfc7009_http_status_returned": { "type": "integer" },
        "rfc7009_trap_warning": { "type": "string" },
        "jwt_residual_ttl_seconds": { "type": "integer", "minimum": 0 },
        "contained_node_ids": { "type": "array", "items": { "type": "string" } },
        "persisting_node_ids": { "type": "array", "items": { "type": "string" } },
        "persisting_edge_ids": { "type": "array", "items": { "type": "string" } },
        "containment_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "ordered_steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/ContainmentStep" }
        }
      }
    },
    "FlaggedScope": {
      "type": "object",
      "required": ["scope_id", "severity", "reason", "recommended_scope_id"],
      "additionalProperties": false,
      "properties": {
        "scope_id": { "type": "string" },
        "severity": { "$ref": "#/$defs/Severity" },
        "reason": { "type": "string" },
        "recommended_scope_id": { "type": "string" }
      }
    },
    "PreConsentDecision": {
      "type": "object",
      "required": [
        "action",
        "provider",
        "risk_score",
        "pkce_protected",
        "pkce_rewrite_warning",
        "flagged_scopes",
        "recommended_scopes",
        "safe_replacement_url"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": ["ALLOW", "WARN", "BLOCK_PRE_CONSENT"]
        },
        "provider": { "$ref": "#/$defs/ProviderId" },
        "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "pkce_protected": { "type": "boolean" },
        "pkce_rewrite_warning": { "type": "string" },
        "flagged_scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/FlaggedScope" }
        },
        "recommended_scopes": { "type": "array", "items": { "type": "string" } },
        "safe_replacement_url": { "type": ["string", "null"] }
      }
    }
  }
}
